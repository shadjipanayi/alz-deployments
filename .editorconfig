root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.bicep]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.ps1]
indent_size = 4
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[LICENSE]
insert_final_newline = true
